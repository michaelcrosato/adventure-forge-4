  "quests": {
    "main": {
      "name": "The Gray",
      "stages": [
        {
          "if": [
            [
              "flag",
              "mg_entered"
            ]
          ],
          "text": "Marrowgate. The Hollow Throne lies under the palace; the Regent will not want you there."
        },
        {
          "if": [
            [
              "flag",
              "act2_open"
            ],
            [
              "var",
              "hollows_rested",
              ">=",
              3
            ]
          ],
          "text": "Three hollows rested. The Keepers can open the pilgrim stair at Coldpass, north past Wardmoor."
        },
        {
          "if": [
            [
              "flag",
              "act2_open"
            ],
            [
              "flag",
              "regent_writ"
            ]
          ],
          "text": "The Regent's writ is yours. Coldpass will let you through to Marrowgate."
        },
        {
          "if": [
            [
              "flag",
              "act2_open"
            ],
            [
              "flag",
              "free_passage"
            ]
          ],
          "text": "The Free Companies will take you under the pass, by the Saltkerns caves."
        },
        {
          "if": [
            [
              "flag",
              "act2_open"
            ]
          ],
          "text": "Six holds, six unrested griefs. Rest three, earn the Regent's writ, or buy the Companies' road — any opens Coldpass."
        },
        {
          "if": [
            [
              "flag",
              "va_king_rested"
            ]
          ],
          "text": "The king rests. See who comes to Last Light square now that he does."
        },
        {
          "if": [
            [
              "flag",
              "va_king_slain"
            ]
          ],
          "text": "The king is dust. See who comes to Last Light square now that he is."
        },
        {
          "if": [
            [
              "flag",
              "va_king_forsaken"
            ]
          ],
          "text": "You left him grieving. See who comes to Last Light square anyway."
        },
        {
          "if": [],
          "text": "The gray runs through nine holds. Settle the Vale's king first; then the roads open."
        }
      ]
    },
    "act1": {
      "name": "Act I — The Vale of Ash",
      "done": [
        [
          "flag",
          "va_king_resolved"
        ]
      ],
      "failed": [
        [
          "flag",
          "va_king_forsaken"
        ]
      ],
      "stages": [
        {
          "if": [
            [
              "flag",
              "va_heard_grievance"
            ]
          ],
          "text": "Settle the Hollow King: speak his verses, return or break his crown, or end him. The doors after are yours too."
        },
        {
          "if": [
            [
              "flag",
              "va_barrow_open"
            ]
          ],
          "text": "The barrow is open. Hear the king at the throne before you decide anything."
        },
        {
          "if": [],
          "text": "Settle the Hollow King in the barrow north of the Vale. Last Light knows the roads; its people know more."
        }
      ]
    }
  },
  "epilogue": [
    {
      "if": [
        [
          "flag",
          "va_king_rested"
        ],
        [
          "flag",
          "va_sealed"
        ]
      ],
      "text": "In the Vale the barrow doors stay shut, as you promised, and white grass grows back over the hill."
    },
    {
      "if": [
        [
          "flag",
          "va_king_rested"
        ],
        [
          "!flag",
          "va_sealed"
        ]
      ],
      "text": "In the Vale the barrow stands open to the sky, and the gray priest goes up on feast days to sit with the king."
    },
    {
      "if": [
        [
          "flag",
          "va_king_slain"
        ]
      ],
      "text": "In the Vale they tell it that a stranger killed the Hollow King with a blade, and the grass came back gray-green and stayed so."
    },
    {
      "if": [
        [
          "flag",
          "va_king_forsaken"
        ]
      ],
      "text": "In the Vale the king still sits his stone seat, grieving. The gray there never fully lifts."
    },
    {
      "if": [
        [
          "flag",
          "va_crown_broken"
        ]
      ],
      "text": "The iron crown lies in pieces on the barrow floor. No one has tried to mend it."
    },
    {
      "if": [
        [
          "flag",
          "va_crown_kept"
        ]
      ],
      "text": "The Hollow King's crown is in your pack still. It has not grown lighter."
    }
  ],
